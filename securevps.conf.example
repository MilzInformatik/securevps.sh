# /etc/securevps.conf
#
# Settings securevps.sh reads on every run. Command line flags override these;
# these override the built-in defaults.
#
# Every flag in "securevps.sh help" is available here, as module.name = value.
# What follows is the subset people actually change. Uncomment what you want.

# --- SSH ------------------------------------------------------------------

# Move sshd off 22. Quieter logs; not by itself security.
#ssh.port = 2222

# Needed for "ssh -L" tunnels to an admin UI bound to 127.0.0.1. Off by
# default, and the default most likely to surprise you.
#ssh.tcp-forwarding = true

# Who may log in at all. Leave allow-groups at sudo unless you have a reason.
#ssh.allow-users = deploy,alice
#ssh.allow-groups = sudo

# Seconds before an unconfirmed sshd change rolls itself back. 0 disables it,
# which you should only do once you have done this a few times.
#ssh.rollback-timeout = 300

# --- accounts -------------------------------------------------------------

#user.name = deploy
#user.ssh-key = /root/.ssh/authorized_keys
#user.sudo-nopasswd = false

# --- firewall -------------------------------------------------------------

# Ports to open. Nothing but SSH is opened unless you say so here.
#firewall.allow = 80,443

# Source-restricted rules, cidr:port.
#firewall.allow-from = 10.0.0.0/8:5432

#firewall.backend = ufw

# --- docker ---------------------------------------------------------------

# Container ports that should be reachable from the public internet. Anything
# not listed here is only reachable from private ranges, whatever the
# container published.
#docker.allow-published = 80,443

# Extra networks allowed to reach published ports.
#docker.allow-from = 203.0.113.0/24

# --- brute force ----------------------------------------------------------

#bruteforce.maxretry = 5
#bruteforce.bantime = 1h
#bruteforce.aggressive = true

# Addresses that must never be banned. The one you are connected from is
# added automatically.
#bruteforce.ignore-ip = 203.0.113.5

# --- updates --------------------------------------------------------------

# Reboot by itself when a patch needs one. Off by default.
#updates.auto-reboot = 04:00

# --- optional extras ------------------------------------------------------

#vpn.provider = tailscale
#vpn.ssh-vpn-only = true

#mfa.enable = true
#mfa.exempt-user = deploy

#integrity.enable = true

#backup.enable = true
#backup.repo = s3:s3.amazonaws.com/my-bucket
#backup.password-file = /etc/securevps/restic-password
